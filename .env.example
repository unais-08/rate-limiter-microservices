# ========================================
# PostgreSQL Configuration
# ========================================
POSTGRES_USER=developer
POSTGRES_PASSWORD=dev
POSTGRES_DB_ADMIN=admin_service_db
POSTGRES_DB_ANALYTICS=rate_limiter_analytics

# ========================================
# Redis Configuration
# ========================================
REDIS_PASSWORD=

# ========================================
# JWT Configuration
# ========================================
JWT_SECRET=my-super-secret-key

# ========================================
# Admin Credentials
# ========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ========================================
# Service URLs (for local development)
# ========================================
# Uncomment these for local development (without Docker)
# ANALYTICS_URL=http://localhost:3003
# RATE_LIMITER_URL=http://localhost:3001
# GATEWAY_URL=http://localhost:3000

# For Docker, these are set automatically in docker-compose.yml
