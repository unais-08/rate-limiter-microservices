# Production Environment Variables
# NEVER commit this file to git!
# Copy from .env.example and fill with production values

# Database (Use strong passwords!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=ratelimiter
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/ratelimiter

# Redis (Use strong password!)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# JWT Secret (Generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_MIN_64_CHARS

# Service URLs (Docker internal network)
ADMIN_SERVICE_URL=http://admin-service:3002
GATEWAY_SERVICE_URL=http://gateway-service:3000
RATE_LIMITER_SERVICE_URL=http://rate-limiter-service:3001
ANALYTICS_SERVICE_URL=http://analytics-service:3003
BACKEND_SERVICE_URL=http://backend-service:5000

# Frontend URLs
# For LOCAL production (Docker on your machine):
#   Use http://localhost with the exposed ports
# For REMOTE production (deployed server with domain):
#   Use https://yourdomain.com or your server's public IP

# Option 1: Local Machine Production (Default)
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# Option 2: Behind Nginx (if using nginx proxy)
# NEXT_PUBLIC_API_URL=http://localhost/api
# NEXT_PUBLIC_GATEWAY_URL=http://localhost/gateway

# Option 3: Remote Server with Domain
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_GATEWAY_URL=https://gateway.yourdomain.com

# Option 4: Remote Server with IP (for testing before DNS setup)
# NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:3002
# NEXT_PUBLIC_GATEWAY_URL=http://YOUR_SERVER_IP:3000

# Node Environment
NODE_ENV=production
